# 主力规划模型（建议 glm-5.3）：composition/布局规划的默认 LLM。
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_RESPONSE_FORMAT=json_object
# 推理型模型（GLM/DeepSeek 等）思考耗时可达 30–90 秒：规划类任务建议
# 60000–110000；注意部分中转网关自身有 ~120 秒硬超时，客户端值不宜低于它。
LLM_TIMEOUT_MS=30000
# 流式规划（默认关闭，行为不变）。推理型模型经中转网关时建议开启：
# 思考增量持续保持连接活跃，可绕过网关空闲超时；流式下 LLM_TIMEOUT_MS
# 约束整个流的总时长（含思考期），慢思考模型建议 240000–300000。
LLM_STREAMING=false
# 本地视觉层（默认开启）：上传时用本地 ONNX 模型（YuNet 人脸检测 +
# ISNet-general-use 主体分割）产出全部几何字段（faces/subjectBox/
# saliencyCenter/subjectContour），VLM 只负责语义字段，视觉调用因此回到
# 轻量 prompt 的秒级量级。模型获取：node scripts/fetch-vision-models.mjs
# （下载并校验到 models/ 目录，仓库已 gitignore）。设为 false 完全跳过
# 本地层（回到纯 VLM 流程）；模型缺失或推理失败会自动降级为像素分析，
# 并把每层成败与耗时写入 analysisWarnings，不影响上传。
LOCAL_VISION_ENABLED=true
# 单图视觉分析（VISION_ENABLED=true 时启用；建议视觉侧模型 glm-5.3-flash）。
VISION_ENABLED=false
VISION_MODEL=
# 语义-only prompt（几何已由本地层承担）为轻量调用，实测回到 4-15s 量级；
# 默认 90000 兼容慢中转网关，可按需下调。
VISION_TIMEOUT_MS=90000
# 多模态规划（可选，缺省 false = 行为与纯文本规划完全一致）。
# 设为 true 且规划请求携带 assetContent 时，规划调用改为多模态消息
# （每张素材一个 image_url part + 素材 id 标注文本，规划 JSON 随后），
# 模型配置复用 LLM_API_KEY / LLM_BASE_URL，可用 VISION_API_KEY /
# VISION_BASE_URL / VISION_MODEL 单独覆盖（超时沿用 VISION_TIMEOUT_MS）。
# 多模态调用失败会自动降级回纯文本规划，再失败落确定性 fallback，
# 每级降级都会写入响应 warnings。
VISION_PLANNING_ENABLED=false
ONE_TOUCH_STORAGE_DIR=
ONE_TOUCH_COMPOSITION_DIR=
LLM_SMOKE_TEST=0
