--- a/src/attach.rs	2026-07-04 14:12:27
+++ b/src/attach.rs	2026-07-04 14:12:11
@@ -95,6 +95,26 @@
 
         WindowsAndMessaging::SetParent(hwnd, worker_w).unwrap();
 
+        // PATCH (P1 Windows verification, error 6): after reparenting into
+        // WorkerW, push the window to the BOTTOM of WorkerW's child Z-order so
+        // it renders behind the SHELLDLL_DefView (desktop icons) instead of
+        // occluding it. Without this, the wallpaper window floats on top of
+        // the desktop icons, Windows treats it as unresponsive, and it gets
+        // destroyed.
+        //
+        // HWND_BOTTOM (raw value 1) places the window at the bottom of the
+        // Z-order. SWP_NOMOVE (0x0002) | SWP_NOSIZE (0x0001) keep the existing
+        // position and size — we only change Z-order.
+        WindowsAndMessaging::SetWindowPos(
+            hwnd,
+            HWND(1 as *mut core::ffi::c_void),
+            0,
+            0,
+            0,
+            0,
+            WindowsAndMessaging::SET_WINDOW_POS_FLAGS(0x0001 | 0x0002),
+        );
+
         if options.transparent {
             toggle_window_transparent(hwnd, true);
         }
