classDiagram
  class ImageAsset {
    string id
    string fileName
    string objectUrl
    number width
    number height
    string orientation
    number fileSize
    ImageAnalysis analysis
  }

  class ImageAnalysis {
    number width
    number height
    string orientation
    string[] dominantColors
    number averageBrightness
    number averageSaturation
    number resolutionScore
    string contentType
    Box[] faces
    Box subjectBox
    string[] styleTags
  }

  class Box {
    number x
    number y
    number w
    number h
  }

  class CanvasLayout {
    string version
    CanvasConfig canvas
    LayoutItem[] items
    SafeArea[] safeAreas
    GlobalStyle globalStyle
    string templateId
  }

  class CanvasConfig {
    number width
    number height
    string ratio
    Background background
  }

  class Background {
    string type
    string color
    string sourceAssetId
    number blur
    number brightness
  }

  class LayoutItem {
    string id
    string assetId
    number x
    number y
    number w
    number h
    number rotation
    number zIndex
    Crop crop
    ItemStyle style
  }

  class Crop {
    number scale
    number offsetX
    number offsetY
  }

  class ItemStyle {
    number radius
    string shadow
    number opacity
    string blendMode
  }

  class SafeArea {
    string type
    number x
    number y
    number w
    number h
  }

  class GlobalStyle {
    string tone
    number grain
    number vignette
    number brightness
    number saturation
  }

  class Template {
    string id
    string name
    string type
    TemplateSlot[] slots
  }

  class TemplateSlot {
    string id
    number x
    number y
    number w
    number h
    number rotation
